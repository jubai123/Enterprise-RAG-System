DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_VECTOR_SIZE=1024

RUN_NAME=RAG_Bench

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_rag_bench

# 重排序默认走硅基流动在线 API（复用上面的 SILICONFLOW_API_KEY），无需本地模型。
# 本地 sentence-transformers 仅作后备：CROSS_ENCODER_PROVIDER=local 时需同时填写
# 模型目录和认证用的目录 tree hash。
CROSS_ENCODER_PROVIDER=online
CROSS_ENCODER_MODEL_PATH=C:\path\to\bge-reranker-v2-m3
CROSS_ENCODER_MODEL_SHA256=5bf0a484eb6b541fe84692257211c008673135f0abbe615f991a31ce194d0a47
